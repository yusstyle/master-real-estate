# Neon PostgreSQL connection string. Keep this server-side; never add a VITE_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
ADMIN_EMAIL=

# Cloudinary credentials (server-side). The Cloudinary secret is never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required to verify administrator accounts; also sends chat notification emails.
CHAT_RECIPIENT_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
