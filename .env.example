# Neon PostgreSQL connection string. Keep this server-side; never add a VITE_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Cloudinary credentials (server-side). The Cloudinary secret is never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required to verify administrator accounts; also sends chat notification emails.
CHAT_RECIPIENT_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Paystack (server-side). Leave blank to disable the application fee.
# Use a TEST key (sk_test_...) first. Never add a VITE_ prefix. Fee is charged in USD per adult.
PAYSTACK_SECRET_KEY=
APPLICATION_FEE_USD=80

# Manual bank transfer (use while Stripe/Paystack are not ready). Setting the account number turns it on
# and it takes priority over Paystack. Applicants see these details after submitting, tell us they have paid,
# and an admin confirms the payment in the dashboard.
MANUAL_PAYMENT_ACCOUNT_NUMBER=
MANUAL_PAYMENT_ACCOUNT_NAME=
MANUAL_PAYMENT_BANK_NAME=
MANUAL_PAYMENT_INSTRUCTIONS=
